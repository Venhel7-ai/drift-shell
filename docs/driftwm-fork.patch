+
+fn shell_camera(
+    name: &str,
+    center: (f64, f64),
+    zoom: f64,
+    anchored: bool,
+    state: &mut DriftWm,
+) -> Reply {
+    if !center.0.is_finite()
+        || !center.1.is_finite()
+        || center.0.abs() > 1e8
+        || center.1.abs() > 1e8
+        || !zoom.is_finite()
+        || !(0.01..=1.0).contains(&zoom)
+    {
+        return Err("invalid shell camera".into());
+    }
+    let output = state
+        .space
+        .outputs()
+        .find(|o| o.name() == name)
+        .cloned()
+        .ok_or("unknown output")?;
+    if state.is_output_fullscreen(&output) {
+        return Err("output is fullscreen".into());
+    }
+    let camera = driftwm::canvas::camera_for_center(
+        center.0,
+        center.1,
+        zoom,
+        crate::state::output_logical_size(&output),
+    );
+    {
+        let mut os = crate::state::output_state(&output);
+        os.camera = camera;
+        os.zoom = zoom;
+        os.shell_anchored = anchored;
+        os.camera_target = None;
+        os.zoom_target = None;
+        os.zoom_animation_anchor = None;
+        os.momentum.stop();
+        os.edge_pan_velocity = None;
+        os.panning = false;
+    }
+    state.mark_all_dirty();
+    Ok(Response::Ok)
+}
+
+fn shell_layout(_revision: u64, targets: Vec<protocol::ShellTarget>, state: &mut DriftWm) -> Reply {
+    if targets.len() > 512 {
+        return Err("too many targets".into());
+    }
+    let mut ids = std::collections::HashSet::new();
+    let mut prepared = Vec::with_capacity(targets.len());
+    // Validate the complete batch before any client receives a configure.
+    // calloop cannot interleave client events between validation and commit.
+    for t in targets {
+        if !ids.insert(t.id)
+            || t.w <= 0
+            || t.h <= 0
+            || t.w > 32768
+            || t.h > 32768
+            || t.x.unsigned_abs() > 100_000_000
+            || t.y.unsigned_abs() > 100_000_000
+        {
+            return Err("invalid layout target".into());
+        }
+        let element = element_by_selector(state, Some(&WindowSelector::Id(t.id)))?;
+        if !state.is_canvas_window(&element) || state.element_under_interactive_grab(&element) {
+            return Err("window is not available for layout".into());
+        }
+        let chrome = state.reported_chrome(&element);
+        let requested = chrome.content_size(Size::from((t.w, t.h)));
+        let (w, h) =
+            crate::state::resize_constraints(&element, chrome).clamp(requested.w, requested.h);
+        if (w, h) != (requested.w, requested.h) {
+            return Err("LAYOUT_MIN_SIZE_CONFLICT".into());
+        }
+        let size = Size::from((w, h));
+        let loc = driftwm::canvas::rule_to_content(t.x, t.y, size, chrome);
+        prepared.push((element, size, loc));
+    }
+    for (element, size, loc) in prepared {
+        state.resize_element_to(&element, size, loc, false, None);
+    }
+    state.session_store_mark_dirty();
+    Ok(Response::Ok)
+}
